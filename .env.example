PROJECT_NAME=kipina-pilot
APP_ENV=production
PUBLIC_BASE_URL=https://pilot.kipina.digiter.fi

# Jaettu pääsykoodi /api/auth/check -tarkistukseen.
# Vaihda pilottivaiheen jälkeen oikeaan auth-järjestelmään.
KIPINA_ACCESS_CODE=change-me-before-running

# Reveal Engine (Cloud Run)
REVEAL_ENGINE_BASE_URL=https://reveal-api-kanavana-XXXXX-lz.a.run.app
REVEAL_ENGINE_TIMEOUT_SECONDS=60

# Concept API (Vertex AI / Gemini)
GCP_PROJECT_ID=apply-project-35406
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.1-pro-preview

# Vibe Prototype API (Vertex AI Agent Engine + Gemini)
PROTOTYPE_GCP_LOCATION=us-central1
PROTOTYPE_GEMINI_MODEL=gemini-3-pro
AGENT_ENGINE_ID=projects/apply-project-35406/locations/us-central1/reasoningEngines/PLACEHOLDER

# Template Proxy (Gemini Flash analyses)
TEMPLATE_PROXY_LOCATION=global
TEMPLATE_GEMINI_MODEL=gemini-2.5-flash

# Tenantit JSON-arrayna. Kopioi tämä pohja ja täytä oikeat tenant_key + api_key -arvot.
KIPINA_TENANTS=[{"id":"mina","name":"Mä itse","description":"Oma arki, omat tarpeet, oma juttu","tenant_key":"PLACEHOLDER","api_key":"PLACEHOLDER"},{"id":"mina-ja-toinen","name":"Mä ja joku toinen","description":"Kaveri, läheinen, joku tärkeä","tenant_key":"PLACEHOLDER","api_key":"PLACEHOLDER"},{"id":"porukka","name":"Mä ja porukka","description":"Kaverit, koulu, harrastus, työ","tenant_key":"PLACEHOLDER","api_key":"PLACEHOLDER"},{"id":"maailma","name":"Mä ja maailma","description":"Yhteiskunta, palvelut, isot jutut","tenant_key":"PLACEHOLDER","api_key":"PLACEHOLDER"},{"id":"emma-tiia","name":"Emmä tiiä","description":"Idea ei liity mihinkään selkeään — selvitetään yhdessä","tenant_key":"PLACEHOLDER","api_key":"PLACEHOLDER"}]
